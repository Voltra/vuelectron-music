{
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": [
			"icons/"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"productName": "vuelectron-music",
	"mainBinaryName": "vuelectron-music",
	"version": "0.0.0",
	"identifier": "fr.voltra.vuelectron-music",
	"plugins": {},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"fullscreen": false,
				"resizable": true,
				"maximized": true,
				"title": "vuelectron-music",
				"width": 800,
				"height": 600,
				"decorations": false,
				//        "fileDropEnabled": true,
				"dragDropEnabled": true,
				"label": "main",
				"visible": false,
				"useHttpsScheme": true
			},
			{
				"width": 460,
				"height": 200,
				"center": true,
				"decorations": false,
				"resizable": false,
				"label": "splashscreen",
				"url": "splashscreen.html",
				"useHttpsScheme": true
			}
		],
		"security": {
			"csp": "default-src 'self' https://asset.localhost asset:; connect-src ipc: http://ipc.localhost",
			"assetProtocol": {
				"enable": true,
				"scope": ["*", "**/*"],
			},
		}
	}
}